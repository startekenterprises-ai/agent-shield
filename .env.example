# ===========================================================================
# Agent-Shield Core Routing Configuration
# ===========================================================================
SEARCH_PROVIDER=searxng
REAL_SEARXNG_URL=http://192.168.2.42:8088

# ===========================================================================
# LLM Endpoint Configurations (Choose One)
# ===========================================================================

# Option A: Local Ollama (Requires strong local GPU)
OLLAMA_HOST=http://192.168.2.42:11434
TARGET_MODEL=qwen2.5-coder-7b:128k

# Option B: Groq Cloud API (Free / Fast cloud fallback)
# GROQ_API_KEY=gsk_your_free_groq_key_here
# TARGET_MODEL=qwen-2.5-coder-32b

# Option C: OpenRouter Free Tier
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# TARGET_MODEL=meta-llama/llama-3-8b-instruct:free


# ===========================================================================
# Agent-Shield Phase 1 — logging-only Pipelines filter (2026-10-07)
# Every key is optional: the filter ships with compiled-in defaults and
# reads AGENTSHIELD_<VALVE_NAME> from the environment. See
# config/pipeline.example.yaml for the full valves reference.
# ===========================================================================

# AGENTSHIELD_LOG_DIR=./logs/agent-shield
# AGENTSHIELD_OLLAMA_BASE_URL=http://localhost:11434
# AGENTSHIELD_TEV1_MODEL=tev1:0.8b
# AGENTSHIELD_SYSTEMONE_PATH=/v1/systemone
# AGENTSHIELD_QUEUE_SIZE=2000
# AGENTSHIELD_WORKER_CONCURRENCY=4
# AGENTSHIELD_CLASSIFIER_TIMEOUT_S=5.0
# AGENTSHIELD_MAX_CLASSIFY_CHARS=8000
# AGENTSHIELD_RAW_SAMPLE_RATE=0.01
# AGENTSHIELD_ENABLE_OUTLET=true
# AGENTSHIELD_PROVISIONAL_BLOCK_THRESHOLD=0.9
# AGENTSHIELD_PROVISIONAL_REDACT_THRESHOLD=0.7
# AGENTSHIELD_LOG_RETENTION_DAYS=30
